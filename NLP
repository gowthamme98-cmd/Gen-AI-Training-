#Text Cleaning Function

ps = PorterStemmer()

def clean_text(text):

    text = text.lower()

    text = re.sub('[^a-zA-Z]', ' ', text)

    words = text.split()

    words = [ps.stem(word) for word in words if word not in stopwords.words('english')]

    return " ".join(words)

#Apply Cleaning

df['Clean_Message'] = df['Message'].apply(clean_text)

