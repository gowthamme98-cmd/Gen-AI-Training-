X,
y,
test_size=0.2,
random_state=42

)

model = MultinomialNB()

model.fit(X_train, y_train)

def predict_message(message):

    message = clean_text(message)

    vector = tfidf.transform([message])

    prediction = model.predict(vector)[0]

    if prediction == 1:
        print("Spam Message")
    else:
        print("Not Spam")

