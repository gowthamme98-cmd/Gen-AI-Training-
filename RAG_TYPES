#Naive RAG

from pypdf import PdfReader
from sentence_transformers import SentenceTransformer
import faiss
import numpy as np

# Read PDF
reader = PdfReader("enterprise_rag_dataset.pdf")

text = ""
for page in reader.pages:
    text += page.extract_text()

# Chunking
chunks = text.split(".")


# Embedding Model
model = SentenceTransformer(
    "all-MiniLM-L6-v2"
)

embeddings = model.encode(chunks)

# Vector Database
index = faiss.IndexFlatL2(384)
index.add(np.array(embeddings))


def naive_rag(query):

    query_embedding = model.encode([query])

    D, I = index.search(
        np.array(query_embedding),
        k=3
    )

    return [chunks[i] for i in I[0]]


print(
    naive_rag(
        "Explain leave policy"
    )
)

#HyDE RAG

def hyde_rag(query):

    # Fake hypothetical answer
    hypothetical_answer = f"""
    Company policy says:
    {query}
    Employees should follow
    company standards.
    """

    query_embedding = model.encode(
        [hypothetical_answer]
    )

    D, I = index.search(
        np.array(query_embedding),
        k=3
    )

    return [chunks[i] for i in I[0]]


print(
    hyde_rag(
        "Explain company policy"
    )
)

#Corrective RAG (CRAG)

def corrective_rag(query):

    result = naive_rag(query)

    if len(result[0]) < 20:

        print("Poor retrieval.")
        return naive_rag(
            query + " company details"
        )

    return result


print(
    corrective_rag(
        "HR"
    )
)

#Graph RAG

graph = {

    "Employee":
    ["HR", "IT"],

    "HR":
    ["Leave Policy"],

    "IT":
    ["Cyber Security"],

    "Cyber Security":
    ["Password Policy"]
}


def graph_rag(node):

    return graph.get(
        node,
        "No Information"
    )


print(
    graph_rag(
        "IT"
    )
)

#Hybrid RAG

def keyword_search(query):

    return [
        c for c in chunks
        if query.lower() in c.lower()
    ]


def hybrid_rag(query):

    vector_results = naive_rag(query)

    keyword_results = keyword_search(
        query
    )

    return (
        vector_results +
        keyword_results
    )


print(
    hybrid_rag(
        "leave"
    )
)

#Adaptive RAG

def adaptive_rag(query):

    if len(query.split()) < 3:

        return naive_rag(query)

    else:

        return hybrid_rag(query)


print(
    adaptive_rag(
        "Explain leave policy"
    )
)

