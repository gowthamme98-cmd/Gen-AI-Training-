    for file in files:

        print(
            f"Processing {file}"
        )


multimodal_rag()

#Agentic RAG

def agentic_rag(query):

    print(
        "Step 1: Retrieve"
    )

    data = naive_rag(query)

    print(
        "Step 2: Analyze"
    )

    print(
        "Step 3: Generate Answer"
    )

    return data


print(
    agentic_rag(
        "Explain cyber security"
    )
)
